# ---------------------------------------------------------------------------
# Scholaris client environment
# Copy to `.env` for local development. Never commit real secrets.
# Only VITE_-prefixed variables reach the browser bundle — treat every value
# here as PUBLIC. Service accounts and API secrets belong on the server.
# ---------------------------------------------------------------------------

# Base path for the REST API. Same-origin in production behind App Hosting.
VITE_API_BASE_URL=/api/v1

# Dev-only: where `vite dev` proxies /api to.
VITE_DEV_API_PROXY=http://localhost:4000

# Public URL of the app, used for verification links and QR codes.
VITE_APP_URL=http://localhost:5173

# Run the UI against the in-browser mock API (MSW). Development only —
# forced off in production builds.
VITE_USE_MOCK_API=true

# Bypass Firebase and sign in against mock personas. Development only.
VITE_USE_MOCK_AUTH=true

# Build a DEMO deployment: the published bundle keeps the mock API and the
# persona sign-in shortcuts, and every screen carries a "this is a demo" banner.
# Set this ONLY on a deployment meant for showing the product on invented data —
# never on a real school's. Leave it unset/false and mocks are compiled out.
VITE_DEMO_MODE=false

# --- Firebase web configuration (public by design) -------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web push (FCM) public VAPID key.
VITE_FIREBASE_VAPID_KEY=
