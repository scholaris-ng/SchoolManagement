# ---------------------------------------------------------------------------
# Scholaris client environment
# Copy to `.env` for local development. Never commit real secrets.
# Only VITE_-prefixed variables reach the browser bundle — treat every value
# here as PUBLIC. Service accounts and API secrets belong on the server.
# ---------------------------------------------------------------------------

# Base path for the REST API. Same-origin in production behind App Hosting.
VITE_API_BASE_URL=/api/v1

# Dev-only: where `vite dev` proxies /api to.
VITE_DEV_API_PROXY=http://localhost:4000

# Public URL of the app, used for verification links and QR codes.
VITE_APP_URL=http://localhost:5173

# Bypass Firebase and sign in against a mock persona in localStorage.
# Development only — used by the Cypress e2e suite's cy.login(), not by the
# running app itself. Leave false to sign in against the real Firebase project.
VITE_USE_MOCK_AUTH=false

# --- Firebase web configuration (public by design) -------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web push (FCM) public VAPID key.
VITE_FIREBASE_VAPID_KEY=
