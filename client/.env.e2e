# ---------------------------------------------------------------------------
# Cypress end-to-end mode — loaded by `npm run dev:e2e` (`vite --mode e2e`).
#
# The whole point of this file is that the app CANNOT reach a real API while
# the E2E suite runs. Dev and production share a database on this project, so
# an unstubbed request must fail, not succeed against real school data.
# ---------------------------------------------------------------------------

# Same-origin as always, so specs can intercept plain `/api/v1/**` paths.
VITE_API_BASE_URL=/api/v1

# ...but the dev proxy points at a dead port. Anything a spec forgot to stub is
# refused immediately (ECONNREFUSED) instead of reaching a server. Port 9 is the
# discard service and is never listening.
VITE_DEV_API_PROXY=http://127.0.0.1:9

VITE_APP_URL=http://localhost:5173

# Mock auth is ON so `cy.login()` can seed a session in localStorage without a
# Firebase project. No Firebase config is set below, so there is nothing to
# reach even if something tried.
VITE_USE_MOCK_AUTH=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
