{
  "name": "@school/api",
  "private": true,
  "version": "0.1.0",
  "description": "Scholaris API — Express + TypeORM + PostgreSQL.",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "migration:run": "tsx typeorm.cli.ts migration:run -d src/infrastructure/database/dataSource.ts",
    "migration:revert": "tsx typeorm.cli.ts migration:revert -d src/infrastructure/database/dataSource.ts",
    "migration:generate": "tsx typeorm.cli.ts migration:generate -d src/infrastructure/database/dataSource.ts",
    "migration:show": "tsx typeorm.cli.ts migration:show -d src/infrastructure/database/dataSource.ts",
    "schema:log": "tsx typeorm.cli.ts schema:log -d src/infrastructure/database/dataSource.ts",
    "seed": "tsx src/infrastructure/database/seeds/run-seed.ts",
    "postman": "node postman/build.mjs"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
