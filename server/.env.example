# ---------------------------------------------------------------------------
# Scholaris API environment (spec section 47)
#
# Copy to `.env` for local development. Never commit real secrets — `.env` is
# gitignored, this file is not.
#
# Every variable here is validated at startup by `src/config/env.ts`; the
# process refuses to boot on an invalid configuration rather than failing later
# on the first request that needs a missing value.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Where the browser app is served from. Used for links and as the default CORS
# origin. Matches the client's own VITE_APP_URL.
APP_URL=http://localhost:5173

# Mounted route prefix. The client's VITE_API_BASE_URL must agree with this.
API_PREFIX=/api/v1

# Comma-separated allowlist. Never a wildcard in production (spec section 40).
# Defaults to APP_URL when unset.
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ------------------------------------------------------------
# Either set DATABASE_URL, or the discrete DB_* variables below. DATABASE_URL
# wins when both are present, which is how a managed provider is pointed at
# without editing anything else (spec section 48).
# DATABASE_URL=postgresql://user:password@host:5432/scholaris?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=scholaris

# Managed providers (Aiven, Neon, Cloud SQL) require TLS; local PostgreSQL has
# none. Leave false locally, true in production.
DB_SSL=false
DB_POOL_SIZE=10
DB_LOGGING=false

# --- Firebase Admin --------------------------------------------------------
# Server-side credentials. These ARE secret, unlike the client's VITE_FIREBASE_*
# values. On Firebase App Hosting or Cloud Run leave them unset so Application
# Default Credentials are used via the metadata server.
#
# Supply EITHER the three discrete values, OR the whole service-account JSON on
# one line as FIREBASE_SERVICE_ACCOUNT_JSON (which is what the setup script
# writes, since one line survives .env parsing without newline escaping).
#
# The service account needs exactly two roles, both necessary:
#   roles/datastore.user      Firestore reads and writes
#   roles/firebaseauth.admin  creating credentials at registration, and
#                             verifyIdToken's revocation check
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes; they are converted to real newlines at startup.
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# --- Development sign-in ---------------------------------------------------
# Accepts `Authorization: Bearer mock-token:<email>`, the form the client's mock
# identity provider already sends, so the finished UI can run against this API
# and a real database before a Firebase project exists. The email must match a
# user that already exists — this creates nobody.
#
# Refused outright when NODE_ENV=production; the process will not start.
DEV_AUTH_ENABLED=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Payments (phase 3) ----------------------------------------------------
PAYSTACK_SECRET_KEY=

# --- Outbound mail ---------------------------------------------------------
# Gmail needs an app password, not the account password. Without both a user
# and a password, verification codes are logged to the console instead of sent.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Scholaris

# How long an emailed verification code stays valid.
VERIFICATION_CODE_TTL_MINUTES=15
